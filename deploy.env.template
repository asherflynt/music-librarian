# Host-specific deployment settings. Copy to <config-dir>/deploy.env and edit.
# Kept OUT of git (see .gitignore) so your network layout isn't published.
# Read by update.sh when it recreates the container.

# Where Soulbeet and Navidrome are reachable from inside the container.
# On bridge networking use the host's LAN IP, not localhost.
SOULBEET_URL=http://<unraid-ip>:9765
NAVIDROME_URL=http://<unraid-ip>:4533

# Host paths.
MUSIC_DIR=/mnt/user/Media/Music   # library (mounted read-only, for size/track counts)
CLUSTER_DIR=/mnt/cluster          # bulk pool  -> MIN_FREE_GB floor is measured here
CACHE_DIR=/mnt/cache              # NVMe pool  -> STAGING_MIN_FREE_GB floor

# Library path AS SEEN BY SOULBEET (passed to its download queue API), not by us.
TARGET_FOLDER=/music
