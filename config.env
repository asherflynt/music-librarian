# Live-tunable settings. The librarian re-reads this file at the top of every
# loop, so edits take effect within a minute or two — no restart needed.

# Stop when EITHER the library reaches this size OR this track count.
TARGET_TB=3
TARGET_TRACKS=100000

# 0.0 = only "more of what you already love"; 1.0 = only horizon-stretching.
EXPLORE_RATIO=0.30

# Hard safety floor: stop adding if the cluster pool drops below this many GB free.
MIN_FREE_GB=500

# Staging (NVMe cache) overflow guard: pause downloads if the staging pool drops
# below this, letting beets/mover drain it. Protects the cache SSD.
STAGING_MIN_FREE_GB=80

# Simultaneous song pipelines. 3-4 is a good balance; higher risks Soulseek throttling.
CONCURRENCY=3

# Re-pull play counts this often (minutes).
TASTE_REFRESH_MIN=360

# Set to 1 to pause downloading without stopping the container.
PAUSED=0
