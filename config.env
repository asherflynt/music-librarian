# Live-tunable settings. The librarian re-reads this file at the top of every
# loop, so edits take effect within a minute or two — no restart needed.
#
# Everything here is also editable in the web UI (http://<server>:8730), which
# writes back to this file and preserves these comments.

# Stop when EITHER the library reaches this size OR this track count.
TARGET_TB=3
TARGET_TRACKS=100000

# 0.0 = only "more of what you already love"; 1.0 = only horizon-stretching.
EXPLORE_RATIO=0.30

# Hard safety floor: stop adding if the cluster pool drops below this many GB free.
MIN_FREE_GB=500

# Staging (NVMe cache) overflow guard: pause downloads if the staging pool drops
# below this, letting beets/mover drain it. Protects the cache SSD.
STAGING_MIN_FREE_GB=80

# Simultaneous song pipelines. 3-4 is a good balance; higher risks Soulseek throttling.
CONCURRENCY=3

# Re-pull play counts this often (minutes).
TASTE_REFRESH_MIN=360

# Re-scan the library this often (seconds). The scan is incremental — unchanged files
# aren't re-read — so this is cheap even at 100k tracks.
MEASURE_EVERY_SEC=300

# Set to 1 to pause downloading without stopping the container.
PAUSED=0

# ---------------------------------------------------------------------------
# Taste weighting
# ---------------------------------------------------------------------------
# Recency decay. A play this many days old counts half as much as one today, so the
# library grows toward what you listen to NOW rather than what you played in 2019.
# Raise it to give old favorites more say; lower it to chase current taste harder.
TASTE_HALF_LIFE_DAYS=365

# Relative trust in each play source. Navidrome and Plex are what you actually play
# in this library; YouTube Music history is the cold-start signal and is weighted
# lower because it includes a lot of incidental listening.
WEIGHT_NAVIDROME=3.0
WEIGHT_PLEX=3.0
WEIGHT_YTMUSIC=1.0

# ---------------------------------------------------------------------------
# Favorites — full discography + new releases (via MusicBrainz)
# ---------------------------------------------------------------------------
# Favorited artists get their ENTIRE discography downloaded, and are re-checked for
# new releases forever. Favorite an artist by starring them in Navidrome, adding
# them in the UI, or listing them in favorites.txt.
FAVORITES_ENABLED=1

# How often to re-check favorites for newly released albums (hours).
FAVORITE_SYNC_HOURS=24

# Queue priority vs the exploration crawl. Higher = downloaded sooner. Favorites
# need to outrank exploration or a discography would queue behind thousands of
# candidates the 100k-track fill has already generated.
FAVORITE_PRIORITY=100

# Which release types count as "the discography".
# Singles are OFF for a reason: Glass Animals alone has 29 singles + 26 remix
# singles vs 4 actual albums. Turning this on will balloon your library with
# near-duplicates of tracks you already have.
FAVORITE_INCLUDE_EP=1
FAVORITE_INCLUDE_SINGLES=0
FAVORITE_INCLUDE_LIVE=0
FAVORITE_INCLUDE_COMPILATIONS=0
FAVORITE_INCLUDE_REMIX=0

# Sent to MusicBrainz, which requires a real contact address in the User-Agent.
MB_USER_AGENT=music-librarian/2.0 ( asherflynt@gmail.com )

# ---------------------------------------------------------------------------
# Scheduled lossy -> FLAC upgrades
# ---------------------------------------------------------------------------
# Periodically re-check albums you own as MP3/AAC to see if a FLAC has appeared on
# Soulseek since. Off by default. Staged FLAC is verified by the upgrade-swap User
# Script before it replaces anything.
UPGRADE_ENABLED=0

# Hour of day (0-23, server local time) to run one pass.
UPGRADE_HOUR=3

# Albums checked per pass. This is the "don't overwhelm anything" dial: each check
# is a full Soulseek search, and hammering peers is how you get banned.
UPGRADE_MAX_PER_RUN=10

# Don't re-check the same album more often than this (days). A FLAC that doesn't
# exist today usually won't exist tomorrow either.
UPGRADE_RECHECK_DAYS=30

# Yield to the main fill: never compete with it for Soulseek slots.
UPGRADE_ONLY_WHEN_IDLE=1
