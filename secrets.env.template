# Rename to secrets.env and fill in. NEVER commit real values.
# Last.fm API key — register a free account/app at https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Your Navidrome login (same credentials you use for Soulbeet).
# The librarian uses these to authenticate to Soulbeet and re-auth on session expiry.
SOULBEET_USER=
SOULBEET_PASS=

# OPTIONAL — Tautulli API key, for counting Plex/Plexamp plays toward your taste.
# Tautulli -> Settings -> Web Interface -> API -> API key.
# Plexamp is a Plex client, so its plays are recorded by Plex and never reach
# Navidrome; without this they simply don't count. Leaving it blank is fine and
# never causes an error — Navidrome + YouTube Music still drive recommendations.
TAUTULLI_API_KEY=
